#!/usr/bin/env bash
# console-diag — rassemble ce qu'il faut pour comprendre un souci d'image ou d'émulateur.
# À lancer en SSH avec l'utilisateur de la console (pas en root), pendant que le problème est à
# l'écran (ou juste après pour un jeu qui ne démarre pas). N'affiche aucun mot de passe.
set -u
uid=$(id -u)
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$uid}
if [[ -z ${SWAYSOCK:-} ]]; then
  for s in "$XDG_RUNTIME_DIR"/sway-ipc.*.sock; do [[ -S $s ]] && export SWAYSOCK=$s && break; done
fi
VAR=$HOME/.var/app
LOGS=$HOME/.local/state/console/logs
section() { printf '\n===== %s =====\n' "$1"; }

section "Écrans"
if outputs=$(swaymsg -t get_outputs -r 2>/dev/null); then
  jq -r '.[] | "\(.name)  actif=\(.active)  mode=\(.current_mode.width // "-")x\(.current_mode.height // "-")  échelle=\(.scale // "-")  position=\(.rect.x),\(.rect.y)  taille=\(.rect.width)x\(.rect.height)"' <<< "$outputs"
else
  echo "sway injoignable : lance cette commande avec l'utilisateur de la console, pendant que l'interface tourne"
fi

section "Fenêtres"
swaymsg -t get_tree -r 2>/dev/null | jq -r '.. | objects | select((.pid? // 0) > 0) | "\(.app_id // .window_properties.class // "?")  [\(.shell // "?")]  cadre=\(.rect.width)x\(.rect.height)+\(.rect.x)+\(.rect.y)  contenu=\(.geometry.width)x\(.geometry.height)  fenêtre=\(.window_rect.width)x\(.window_rect.height)+\(.window_rect.x)+\(.window_rect.y)  plein-écran=\(.fullscreen_mode)  visible=\(.visible)"'

section "RetroArch"
RA=$VAR/org.libretro.RetroArch/config/retroarch
grep -E '^(video_driver|video_context_driver|driver_switch_enable|video_fullscreen|savestate_auto_save|savestate_auto_load) ' "$RA/retroarch.cfg" 2>/dev/null
echo "Cœurs :"
for c in "$RA"/cores/*_libretro.so; do [[ -f $c ]] && printf '  %-34s %s octets\n' "$(basename "$c")" "$(stat -c %s "$c")"; done
echo "Réglages propres à un cœur :"
find "$RA/config" -name '*.cfg' -printf '  %P\n' 2>/dev/null

section "Dolphin"
grep -HE '^(GFXBackend|Fullscreen|RenderToMain|FullscreenDisplayRes|AspectRatio|InternalResolution|wideScreenHack|Crop) ' \
  "$VAR/org.DolphinEmu.dolphin-emu/config/dolphin-emu/Dolphin.ini" "$VAR/org.DolphinEmu.dolphin-emu/config/dolphin-emu/GFX.ini" 2>/dev/null \
  | sed "s#^$VAR/org.DolphinEmu.dolphin-emu/config/dolphin-emu/##"

section "Jeux N64"
for f in "$HOME"/ROMs/n64/*; do
  [[ -f $f ]] || continue
  printf '  %s  %s octets  en-tête %s\n' "$(basename "$f")" "$(stat -c %s "$f")" "$(head -c 4 "$f" | od -An -tx1 | tr -d ' \n')"
done

section "Derniers journaux des émulateurs"
for f in "$LOGS"/emu-*.log "$LOGS"/game.log; do
  [[ -f $f ]] || continue
  echo "--- $(basename "$f")  ($(date -r "$f" '+%d/%m %H:%M'))"
  grep -vE '^\s*$' "$f" | tail -n 45
done
if [[ -f $HOME/ES-DE/logs/es_log.txt ]]; then
  echo "--- ES-DE"
  grep -E 'Launching|launch|Error|error|Warning' "$HOME/ES-DE/logs/es_log.txt" | tail -n 8
fi
