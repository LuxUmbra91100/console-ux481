#!/bin/sh
# Lancé par greetd (connexion automatique) : démarre le compositeur de la console.
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=sway
export XDG_SESSION_DESKTOP=sway
export MOZ_ENABLE_WAYLAND=1
export LIBVA_DRIVER_NAME=iHD
export SDL_VIDEO_MINIMIZE_ON_FOCUS_LOSS=0
# sway compose toujours l'image au lieu de confier celle d'un jeu plein écran directement à l'écran
# (« direct scanout ») : les jeux Wayland natifs (RetroArch…) pouvaient rester figés sur un écran
# noir. Le coût est négligeable. Remettre 0 dans ~/.config/console/session.env pour revenir en arrière.
export WLR_SCENE_DISABLE_DIRECT_SCANOUT=1
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export _JAVA_AWT_WM_NONREPARENTING=1
export XCURSOR_THEME=Adwaita
export XCURSOR_SIZE=32
# Réglages personnels éventuels (variables d'environnement)
[ -r "$HOME/.config/console/session.env" ] && . "$HOME/.config/console/session.env"

: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"
/opt/console/bin/console-outputs-preconf > "$XDG_RUNTIME_DIR/console-outputs.conf" 2>/dev/null \
  || : > "$XDG_RUNTIME_DIR/console-outputs.conf"

start=$(date +%s)
systemd-cat -t sway sway --config /etc/console/sway.conf
status=$?
# Si sway s'arrête tout de suite (problème graphique), on évite une boucle de relance trop rapide.
[ $(( $(date +%s) - start )) -lt 10 ] && sleep 3
systemctl --user stop console-session.target graphical-session.target 2>/dev/null
exit $status
