#!/bin/bash
# console-root — petites actions matérielles autorisées à l'utilisateur de la console
# (via sudo sans mot de passe, voir /etc/sudoers.d/console-ux481). Arguments validés strictement.
set -u
PATH=/usr/sbin:/usr/bin:/sbin:/bin

screenpad_off() {
  local d
  for d in /sys/class/backlight/*screenpad*; do
    [[ -d $d ]] || continue
    [[ -w $d/brightness ]] && echo 0 > "$d/brightness" 2>/dev/null
    [[ -w $d/bl_power ]] && echo 4 > "$d/bl_power" 2>/dev/null
  done
  return 0
}

wake_setup() {
  local hci iface usbdev p
  # L'adaptateur Bluetooth (USB) peut réveiller la machine : bouton Xbox = réveil.
  for hci in /sys/class/bluetooth/hci*; do
    [[ -e $hci/device ]] || continue
    iface=$(readlink -f "$hci/device")
    usbdev=$(dirname "$iface")
    [[ -w $usbdev/power/wakeup ]] && echo enabled > "$usbdev/power/wakeup" 2>/dev/null
  done
  # Le contrôleur USB lui-même doit être autorisé à réveiller (ACPI + PCI).
  if grep -Eq '^XHC[0-9]?\s.*\*disabled' /proc/acpi/wakeup 2>/dev/null; then
    for p in $(awk '/^XHC[0-9]?\s.*\*disabled/ {print $1}' /proc/acpi/wakeup); do
      echo "$p" > /proc/acpi/wakeup 2>/dev/null
    done
  fi
  for p in /sys/bus/pci/devices/*; do
    [[ $(cat "$p/class" 2>/dev/null) == 0x0c0330 && -w $p/power/wakeup ]] \
      && echo enabled > "$p/power/wakeup" 2>/dev/null
  done
  return 0
}

rtc_alarm() {
  local rtc=/sys/class/rtc/rtc0/wakealarm arg=${1:-}
  [[ -w $rtc ]] || { echo "pas d'horloge RTC réveillable" >&2; exit 3; }
  echo 0 > "$rtc"
  if [[ $arg == clear ]]; then
    return 0
  elif [[ $arg =~ ^[0-9]{1,4}$ ]] && (( arg >= 10 )); then
    echo "+$arg" > "$rtc"
  else
    echo "usage : rtc-alarm SECONDES|clear" >&2; exit 2
  fi
}

mem_sleep() {
  local mode=${1:-}
  [[ $mode == s2idle || $mode == deep ]] || { echo "mode invalide" >&2; exit 2; }
  grep -qw "$mode" /sys/power/mem_sleep || { echo "mode $mode non pris en charge" >&2; exit 3; }
  echo "$mode" > /sys/power/mem_sleep
  mkdir -p /etc/systemd/sleep.conf.d
  printf '# console-ux481 : mode de veille choisi dans les réglages\n[Sleep]\nMemorySleepMode=%s\n' "$mode" \
    > /etc/systemd/sleep.conf.d/60-console-memsleep.conf
}

# Lecture seule : état SMART du disque système et erreurs d'accès relevées par le noyau depuis
# le démarrage (Réglages › Santé). Sortie JSON.
health() {
  local src dev smart='null' io
  src=$(findmnt -no SOURCE / 2>/dev/null)
  dev=$(lsblk -no PKNAME "$src" 2>/dev/null | head -n1)
  [[ $dev =~ ^[a-z0-9]+$ ]] || dev=nvme0n1
  if command -v smartctl >/dev/null; then
    smart=$(timeout 15 smartctl -j -a "/dev/$dev" 2>/dev/null) || true
    [[ $smart == "{"* ]] || smart='null'
  fi
  io=$(journalctl -k -b --no-pager -o cat 2>/dev/null \
         | grep -cE 'I/O error|controller is down|EXT4-fs error|Buffer I/O error') || true
  printf '{"device": "%s", "smart": %s, "kernel_io_errors": %d}\n' "$dev" "$smart" "${io:-0}"
}

# Clé USB : montage en lecture seule pour importer jeux et BIOS. Seulement une partition d'un
# disque USB (ou débranchable à chaud), jamais le disque système ; options nosuid/nodev/noexec.
usb_check() {
  local part=$1 disk tran hot
  [[ $part =~ ^sd[a-z]{1,2}[0-9]{0,2}$ ]] || { echo "partition invalide" >&2; exit 2; }
  [[ -b /dev/$part ]] || { echo "partition absente" >&2; exit 3; }
  disk=$(lsblk -ndo PKNAME "/dev/$part" 2>/dev/null | head -n1)
  [[ -n $disk ]] || disk=$part
  tran=$(lsblk -ndo TRAN "/dev/$disk" 2>/dev/null | tr -d ' ')
  hot=$(lsblk -ndo HOTPLUG "/dev/$disk" 2>/dev/null | tr -d ' ')
  [[ $tran == usb || $hot == 1 ]] || { echo "pas un disque USB" >&2; exit 3; }
}

usb_mount() {
  local part=${1:-} fstype uid gid opts mp
  usb_check "$part"
  mp=$(findmnt -rno TARGET "/dev/$part" 2>/dev/null | head -n1)
  if [[ -n $mp ]]; then echo "$mp"; return 0; fi        # déjà montée ailleurs : on la lit là
  fstype=$(blkid -o value -s TYPE "/dev/$part" 2>/dev/null)
  uid=$(id -u "${SUDO_USER:-}" 2>/dev/null || echo 1000)
  gid=$(id -g "${SUDO_USER:-}" 2>/dev/null || echo 1000)
  opts="ro,nosuid,nodev,noexec"
  case $fstype in
    vfat|exfat) opts+=",uid=$uid,gid=$gid,fmask=0133,dmask=0022,iocharset=utf8" ;;
    ntfs) fstype=ntfs3; opts+=",uid=$uid,gid=$gid,iocharset=utf8" ;;
    hfsplus) opts+=",uid=$uid,gid=$gid" ;;
    ext2|ext3|ext4|btrfs|iso9660|udf) ;;
    *) echo "système de fichiers non pris en charge : ${fstype:-inconnu}" >&2; exit 3 ;;
  esac
  mp=/media/console-usb/$part
  mkdir -p "$mp"
  if ! mount -t "$fstype" -o "$opts" "/dev/$part" "$mp" 2>/dev/null; then
    if [[ $fstype == ntfs3 ]] && command -v ntfs-3g >/dev/null \
       && ntfs-3g -o "ro,nosuid,nodev,noexec,uid=$uid,gid=$gid" "/dev/$part" "$mp" 2>/dev/null; then
      :
    else
      rmdir "$mp" 2>/dev/null; echo "montage impossible" >&2; exit 4
    fi
  fi
  echo "$mp"
}

usb_unmount() {
  local part=${1:-} mp
  [[ $part =~ ^sd[a-z]{1,2}[0-9]{0,2}$ ]] || { echo "partition invalide" >&2; exit 2; }
  mp=/media/console-usb/$part
  if mountpoint -q "$mp" 2>/dev/null; then
    umount "$mp" 2>/dev/null || umount -l "$mp" 2>/dev/null   # clé déjà retirée : démontage différé
  fi
  rmdir "$mp" 2>/dev/null
  return 0
}

cmd=${1:-}
shift || true
case "$cmd" in
  hw-init|post-resume) screenpad_off; wake_setup ;;
  pre-sleep) wake_setup ;;
  screenpad-off) screenpad_off ;;
  rtc-alarm) rtc_alarm "$@" ;;
  mem-sleep) mem_sleep "$@" ;;
  health) health ;;
  usb-mount) usb_mount "$@" ;;
  usb-unmount) usb_unmount "$@" ;;
  *) echo "usage : console-root hw-init|post-resume|pre-sleep|screenpad-off|rtc-alarm N|clear|mem-sleep s2idle|deep|health|usb-mount sdX1|usb-unmount sdX1" >&2
     exit 2 ;;
esac
exit 0
